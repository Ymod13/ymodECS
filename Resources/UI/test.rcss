/* test.rcss */
body {
    text-align: center;
    width: 100%;
    height: 100%;
}

.content {
    position: absolute;
    top: 20px;
    right: 20px;

    width: 300px;
    height: 150px;
    line-height: 150px;
    background-color: #000030;
    border: 2px #808080;
    border-radius: 8px;
   
    align-items: center;
    justify-content: center;

    font-family: Roboto;
    font-size: 36px;
    color: white;
    text-align: center;
}