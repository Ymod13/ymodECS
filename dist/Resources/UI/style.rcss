body {
  text-align: center;
  width: 100%;
  height: 100%;
  font-family: Roboto;
}

.game_info {
  background-color: #000030;
  border: 2px #808080;
  border-radius: 8px;
  padding: 15px;
  position: absolute;
  top: 20px;
  right: 20px;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: white;
  text-align: center;
}

.author {
  font-size: 12px;
}

button {
  background-color: #000030;
  border: 2px #808080;
  border-radius: 8px;
  padding: 15px;
  color: #ffffff;
  font-size: 36px;
  transform: translateY(0px) scale(1);
  transition: transform 0.25s linear-in-out;
}

button:hover {
  background-color: #aaaaaa;
  transform: translateY(4px) scale(1.1);
}

.bottom_messages {
  font-size: 18px;
  position: absolute;
  bottom: 20px;
  left: 0;
  right: 0;
  text-align: center;
}

.normal_text_box {
  background-color: #2c0b0b;
  border: 2px #651919;
  border-radius: 8px;
  padding: 15px;
  display: inline-block;
  opacity: 0.75;
}

.normal_text {
  color: white;
  opacity: 1;
}

/*# sourceMappingURL=style.rcss.map */
