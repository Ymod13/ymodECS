{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src/ts",
    "outDir": "./Scripts",

    // Environment Settings
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*"]
}
